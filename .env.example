# App Domain Configuration
APP_URL="https://imglink.web.id"

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://ep-sample.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-sample.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://br-sample.storage.c-3.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="nak_live_sample"
AWS_SECRET_ACCESS_KEY="nsk_live_sample"

# Backblaze B2 Storage (Optional Alternative if STORAGE_PROVIDER="b2")
# STORAGE_PROVIDER="b2"
# B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
# B2_REGION="us-east-005"
# B2_KEY_ID="sample_key_id"
# B2_APPLICATION_KEY="sample_application_key"
# B2_BUCKET_NAME="sample-bucket"

# Security & Admin Clearance
JWT_SECRET="generate-a-secure-random-32-char-secret"
ADMIN_SECRET_PIN="sample_pin_or_passkey"
ADMIN_EMAILS="admin@example.com"
